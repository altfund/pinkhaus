# Blockchain RPC Configuration
# Get free API keys from:
# - Alchemy: https://www.alchemy.com/
# - Infura: https://infura.io/
# - Ankr: https://www.ankr.com/

# Optimism RPC URLs (use your own API key)
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Alternative: https://optimism-mainnet.infura.io/v3/YOUR_API_KEY

# Arbitrum RPC URLs (use your own API key)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Alternative: https://arbitrum-mainnet.infura.io/v3/YOUR_API_KEY

# Etherscan API Keys (for ABI fetching)
OPTIMISM_ETHERSCAN_KEY=YOUR_OPTIMISM_ETHERSCAN_KEY
ARBITRUM_ETHERSCAN_KEY=YOUR_ARBITRUM_ETHERSCAN_KEY

# Graph Node Configuration (if self-hosting)
GRAPH_NODE_URL=http://localhost:8020/
IPFS_URL=http://localhost:5001/

# Overtime API Key (if available)
OVERTIME_API_KEY=