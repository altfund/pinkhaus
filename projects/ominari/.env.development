# Development Environment Configuration
# Used for local automated trading and backtesting

# Database
DATABASE_URL=postgresql://ominari_user:ominari_2025_secure@localhost:5999/database_v2
POSTGRES_HOST=localhost
POSTGRES_PORT=5999
POSTGRES_DB=database_v2
POSTGRES_USER=ominari_user
POSTGRES_PASSWORD=ominari_2025_secure

# Blockchain
BLOCKCHAIN_RPC_URL=https://mainnet.optimism.io
CHAIN_ID=10
NETWORK=optimism

# API Keys (for development)
OVERTIME_API_KEY=dev_api_key
API_SECRET_KEY=dev_secret_key_12345

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Dashboard Configuration
ALLOWED_SPORTS=Soccer
ALLOWED_LEAGUES=
ALLOWED_NATIONS=
DASHBOARD_PORT=8888

# Trading Configuration
PAPER_TRADING_ENABLED=true
REAL_TRADING_ENABLED=false
MAX_POSITION_SIZE=5000
MIN_EDGE_PERCENT=2.0
KELLY_FRACTION=0.25

# Automated Trading Settings
AUTO_TRADING_ENABLED=true
AUTO_BACKTESTING_ENABLED=true
BACKTEST_INTERVAL_HOURS=1
BLOCKCHAIN_SYNC_INTERVAL_MINUTES=5
TRADING_CYCLE_INTERVAL_SECONDS=60

# Development Features
ENABLE_BLOCKCHAIN_SYNC=true
ENABLE_PAPER_TRADING=true
ENABLE_REAL_TRADING=false
ENABLE_STOP_LOSS=true
ENABLE_PERFORMANCE_MONITOR=true

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
PERFORMANCE_DASHBOARD_PORT=8889