# Ominari Trading System Environment Variables

# Database
DATABASE_URL=sqlite:///sport_odds.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/ominari

# Blockchain RPC Endpoints (Optional - system will use free endpoints if not set)
# Get free API keys from:
# - Alchemy: https://alchemy.com
# - Infura: https://infura.io
# - QuickNode: https://quicknode.com

# Alchemy (Recommended)
ALCHEMY_API_KEY=your-alchemy-api-key-here

# Infura
INFURA_API_KEY=your-infura-api-key-here

# QuickNode
QUICKNODE_API_KEY=your-quicknode-api-key-here

# Custom RPC URLs (highest priority)
OPTIMISM_RPC_URL=
ARBITRUM_RPC_URL=

# Trading Configuration
TRADING_PRIVATE_KEY=  # WARNING: Only for production trading!
PAPER_TRADING_MODE=true

# Risk Management
RISK_PRESET=conservative  # conservative, moderate, aggressive
INITIAL_BANKROLL=1000
MAX_POSITION_SIZE_PCT=0.02
MIN_EDGE_REQUIRED=0.015

# Monitoring
TELEMETRY_ENABLED=true
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

# API Configuration
API_PORT=8888
API_HOST=0.0.0.0
ENABLE_CORS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ominari.log

# Data Sources
OVERTIME_API_KEY=
ODDS_API_KEY=

# Signal Configuration
SIGNAL_REGISTRY_METHOD=bayesian  # equal, inverse_variance, bayesian, online_learning, regime_based
SIGNAL_UPDATE_INTERVAL=300  # seconds

# Development
DEBUG=false
TESTING=false