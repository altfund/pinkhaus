# Production Environment Configuration
# Copy to .env.production and update with real values

# Database
DATABASE_URL=postgresql://ominari_user:CHANGE_ME@rds.amazonaws.com:5432/ominari_production
POSTGRES_HOST=rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=ominari_production
POSTGRES_USER=ominari_user
POSTGRES_PASSWORD=CHANGE_ME

# Blockchain
BLOCKCHAIN_RPC_URL=https://YOUR_RPC_ENDPOINT
CHAIN_ID=10
NETWORK=optimism

# API Keys
OVERTIME_API_KEY=YOUR_API_KEY
API_SECRET_KEY=GENERATE_SECURE_KEY

# Redis Cache
REDIS_URL=redis://elasticache.amazonaws.com:6379/0

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Dashboard Configuration
ALLOWED_SPORTS=Soccer
ALLOWED_LEAGUES=
ALLOWED_NATIONS=
DASHBOARD_PORT=8888

# Trading Configuration
PAPER_TRADING_ENABLED=true
MAX_POSITION_SIZE=5000
MIN_EDGE_PERCENT=2.0
KELLY_FRACTION=0.25

# Security
SECRET_KEY=GENERATE_SECURE_KEY
ALLOWED_ORIGINS=https://ominari.trading
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true

# Monitoring
SENTRY_DSN=YOUR_SENTRY_DSN
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=YOUR_ACCOUNT_ID
ECR_REGISTRY=YOUR_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com

# Feature Flags
ENABLE_BLOCKCHAIN_SYNC=true
ENABLE_PAPER_TRADING=true
ENABLE_REAL_TRADING=false
ENABLE_STOP_LOSS=true