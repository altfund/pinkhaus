# Production Environment Configuration
# Copy to .env and modify as needed

# Hybrid Database Configuration (NEW)
PG_HOST=localhost
PG_PORT=5435
PG_USER=ominari_user
PG_PASSWORD=ominari_2025_secure
PG_DB=ominari_production

# Legacy SQLite (historical data)
DATABASE_URL=sqlite:///sport_odds.db

# Trading Configuration (IMPORTANT: Start with paper trading!)
TRADING_PRIVATE_KEY=  # SET THIS SECURELY IN PRODUCTION
PAPER_TRADING_MODE=true  # Change to false only when ready
RISK_PRESET=conservative  # conservative, moderate, aggressive

# Initial Configuration
INITIAL_BANKROLL=1000
MAX_POSITION_SIZE_PCT=0.02
MIN_EDGE_REQUIRED=0.015

# API Configuration
API_PORT=8888
API_HOST=0.0.0.0
ENABLE_CORS=true

# Data Sources (Optional - system will use defaults)
OVERTIME_API_KEY=
ODDS_API_KEY=
ALCHEMY_API_KEY=
INFURA_API_KEY=

# Blockchain RPC (Optional - will use free endpoints)
OPTIMISM_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=

# Signal Configuration
SIGNAL_REGISTRY_METHOD=bayesian
SIGNAL_UPDATE_INTERVAL=300

# Monitoring
TELEMETRY_ENABLED=true
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ominari.log

# Development
DEBUG=false
TESTING=false